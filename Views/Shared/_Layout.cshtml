@inject NEXT.Services.LayoutDataService LayoutSvc
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var d = await LayoutSvc.GetAsync();
    var me = d.User;
    if (me is null)
    {
        // The account was removed while a cookie was still valid.
        Context.Response.Redirect("/Account/Login");
        return;
    }
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var routeUser = ViewContext.RouteData.Values["username"]?.ToString();
    var onOwnProfile = controller == "Profile" && string.Equals(routeUser, me.UserName, StringComparison.OrdinalIgnoreCase);

    var nav = new (string Icon, string Label, string Url, bool Active, string Badge, int Count, bool Mobile)[]
    {
        ("fa-solid fa-house", "Home", "/", controller == "Home", "", 0, true),
        ("fa-solid fa-user-group", "Friends", "/Friends", controller == "Friends", "requests", d.PendingRequests, true),
        ("fa-regular fa-comment", "Messages", "/Messages", controller == "Messages", "messages", d.UnreadMessages, true),
        ("fa-regular fa-bell", "Notifications", "/Notifications", controller == "Notifications", "notifications", d.UnreadNotifications, true),
        ("fa-solid fa-magnifying-glass", "Search", "/Search", controller == "Search", "", 0, false),
        ("fa-regular fa-user", "Profile", "/u/" + me.UserName, onOwnProfile, "", 0, true),
        ("fa-solid fa-gear", "Settings", "/Settings", controller == "Settings", "", 0, false),
    };
}
<!DOCTYPE html>
<html lang="en" data-theme="@d.Theme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
    <title>@(ViewData["Title"] is string t && t.Length > 0 ? t + " · NEXT" : "NEXT")</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/next.css" asp-append-version="true" />
</head>
<body data-user-id="@me.Id" data-user-name="@me.UserName">

<aside class="sidebar">
    <a class="brand" href="/" aria-label="NEXT home">
        <partial name="_Logo" model="(int?)30" />
        <span class="brand-word">NEXT</span>
    </a>
    @foreach (var n in nav)
    {
        <a class="nav-link @(n.Active ? "active" : "")" href="@n.Url" title="@n.Label">
            <i class="@n.Icon"></i><span class="label">@n.Label</span>
            @if (n.Badge != "") { <span class="nav-badge" data-badge="@n.Badge" hidden="@(n.Count <= 0)">@n.Count</span> }
        </a>
    }
    <div class="sidebar-user">
        <a href="/u/@me.UserName"><partial name="_Avatar" model="new AvatarVm(me.ProfilePicturePath, me.FullName, 34)" /></a>
        <div class="who"><b>@me.FullName</b><span>@@@me.UserName</span></div>
        <form asp-controller="Account" asp-action="Logout" method="post" class="inline-form">
            <button class="icon-btn" title="Log out" aria-label="Log out"><i class="fa-solid fa-arrow-right-from-bracket"></i></button>
        </form>
    </div>
</aside>

<header class="topbar-mobile">
    <a class="brand" href="/"><partial name="_Logo" model="(int?)26" /><span class="brand-word">NEXT</span></a>
    <a class="icon-btn" href="/Search" aria-label="Search"><i class="fa-solid fa-magnifying-glass"></i></a>
    <a class="icon-btn" href="/Settings" aria-label="Settings"><i class="fa-solid fa-gear"></i></a>
</header>

<main class="main">
    <div class="content @(ViewData["Wide"] is true ? "wide" : "")">
        @RenderBody()
    </div>
</main>

<nav class="bottomnav" aria-label="Main">
    @foreach (var n in nav.Where(x => x.Mobile))
    {
        <a class="@(n.Active ? "active" : "")" href="@n.Url" aria-label="@n.Label">
            <i class="@n.Icon"></i>
            @if (n.Badge != "") { <span class="nav-badge" data-badge="@n.Badge" hidden="@(n.Count <= 0)">@n.Count</span> }
        </a>
    }
</nav>

<div id="toasts" data-toast="@TempData["Toast"]" data-toast-type="@TempData["ToastType"]"></div>

<script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
