@model PostViewModel
<article class="card post" data-post-id="@Model.Id" data-author-id="@Model.AuthorId">
    <header class="post-head">
        <a href="/u/@Model.AuthorUserName"><partial name="_Avatar" model="new AvatarVm(Model.AuthorAvatar, Model.AuthorName, 40)" /></a>
        <div class="post-meta">
            <a class="name" href="/u/@Model.AuthorUserName">@Model.AuthorName</a>
            <div class="sub">
                <a href="/Posts/Details/@Model.Id"><time datetime="@Model.CreatedAt.Iso()">@Model.CreatedAt.ToString("MMM d, yyyy")</time></a>
                @if (Model.UpdatedAt.HasValue) { <span> · edited</span> }
                @if (Model.IsShare) { <span> · shared a post</span> }
            </div>
        </div>
        @if (Model.IsOwner)
        {
            <button class="icon-btn" data-act="edit" title="Edit post" aria-label="Edit post"><i class="fa-regular fa-pen-to-square"></i></button>
            <button class="icon-btn" data-act="delete" title="Delete post" aria-label="Delete post"><i class="fa-regular fa-trash-can"></i></button>
        }
    </header>

    <div class="post-body">
        @if (Model.Content.Length > 0)
        {
            <p class="post-text" data-text>@Model.Content</p>
        }
        @if (Model.ImagePath is not null)
        {
            <a href="@Model.ImagePath" target="_blank" rel="noopener"><img class="post-image" src="@Model.ImagePath" alt="Post image" loading="lazy" /></a>
        }
        @if (Model.IsShare)
        {
            if (Model.Shared is not null)
            {
                <div class="shared-box">
                    <div class="post-head">
                        <a href="/u/@Model.Shared.AuthorUserName"><partial name="_Avatar" model="new AvatarVm(Model.Shared.AuthorAvatar, Model.Shared.AuthorName, 32)" /></a>
                        <div class="post-meta">
                            <a class="name" href="/u/@Model.Shared.AuthorUserName">@Model.Shared.AuthorName</a>
                            <div class="sub"><a href="/Posts/Details/@Model.Shared.Id"><time datetime="@Model.Shared.CreatedAt.Iso()">@Model.Shared.CreatedAt.ToString("MMM d, yyyy")</time></a></div>
                        </div>
                    </div>
                    @if (Model.Shared.Content.Length > 0) { <p class="post-text">@Model.Shared.Content</p> }
                    @if (Model.Shared.ImagePath is not null) { <img class="post-image" src="@Model.Shared.ImagePath" alt="Shared post image" loading="lazy" /> }
                </div>
            }
            else
            {
                <div class="shared-box unavailable"><i class="fa-regular fa-eye-slash"></i> This post is no longer available.</div>
            }
        }
    </div>

    <div class="post-stats">
        <span><i class="fa-solid fa-heart"></i><b data-like-count>@Model.LikeCount</b></span>
        <span><i class="fa-regular fa-comment"></i><b data-comment-count>@Model.CommentCount</b></span>
        <span><i class="fa-solid fa-retweet"></i><b data-share-count>@Model.ShareCount</b></span>
    </div>

    <footer class="post-footer">
        <button class="act @(Model.LikedByMe ? "liked" : "")" data-act="like">
            <i class="@(Model.LikedByMe ? "fa-solid" : "fa-regular") fa-heart"></i> Like
        </button>
        <button class="act" data-act="comments"><i class="fa-regular fa-comment"></i> Comment</button>
        @if (!Model.IsOwner)
        {
            <button class="act" data-act="share"><i class="fa-solid fa-retweet"></i> Share</button>
        }
    </footer>
    <div class="comments" hidden></div>
</article>
