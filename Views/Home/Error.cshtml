@model string
@{ ViewData["Title"] = "Error"; }
<div class="card auth-card" style="text-align:center; margin:40px auto">
    <h1>Something went wrong</h1>
    <p class="muted" style="margin:8px 0 6px">We hit an unexpected problem. Please try again.</p>
