@model int
@{
    ViewData["Title"] = Model == 404 ? "Not found" : "Error";
    var message = Model switch
    {
        404 => "We couldn't find what you were looking for.",
        403 => "You don't have permission to see that.",
        _ => "Something went wrong."
    };
}
<div class="card auth-card" style="text-align:center; margin:40px auto">
    <h1>@(Model == 404 ? "Page not found" : "Error " + Model)</h1>
    <p class="muted" style="margin:8px 0 18px">@message</p>
    <a class="n-btn primary" href="/">Back to home</a>
</div>
