@{
    ViewData["Title"] = "Home";
    var scope = ViewBag.Scope is FeedScope s ? s : FeedScope.Network;
}
<div class="tabs">
    <a class="tab @(scope == FeedScope.Network ? "active" : "")" href="/?scope=Network">Friends &amp; following</a>
    <a class="tab @(scope == FeedScope.Everyone ? "active" : "")" href="/?scope=Everyone">Everyone</a>
</div>

<partial name="_Composer" />

<div id="feed" style="margin-top:12px" data-feed-url="/Posts/Feed?scope=@scope">
    @for (var i = 0; i < 3; i++)
    {
        <div class="card skeleton-card" aria-hidden="true">
            <div class="sk-row"><div class="sk sk-av"></div><div style="flex:1"><div class="sk sk-line" style="width:35%"></div><div class="sk sk-line" style="width:20%"></div></div></div>
            <div class="sk sk-line" style="width:92%"></div>
            <div class="sk sk-line" style="width:78%"></div>
            <div class="sk" style="height:120px;margin-top:10px"></div>
        </div>
    }
</div>
